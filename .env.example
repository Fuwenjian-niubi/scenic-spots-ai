# 景点讲解 AI 环境变量示例
# 复制为 .env 或直接 export，切勿把真实 Key 提交到仓库。

# DeepSeek 聊天模型（https://platform.deepseek.com）
DEEPSEEK_API_KEY=

# 智谱 embedding-3（https://open.bigmodel.cn）
ZHIPU_API_KEY=

# AnythingLLM 客户端（scripts/demo_chat.py / demo_voice.py）
ALLM_BASE=http://localhost:3001
ALLM_KEY=
ALLM_SLUG=scenic-spots
